// Full replacement of the vanilla input{} block: niri uses the LAST one
// defined, so this must be included AFTER cfg/input.kdl.
//
// Differences from vanilla:
//   - touchpad: click-method "clickfinger"
//   - touchpad: natural-scroll disabled (was enabled)
//   - disable-power-key-handling, so the power key reaches the XF86PowerOff
//     binding (paired with HandlePowerKey=ignore in
//     /etc/systemd/logind.conf.d/00-power-key.conf on the system side)
//   - a gestures{} block with hot-corners off

input {
    disable-power-key-handling

    keyboard {
        xkb {
            // OS default layout. To override:
            //layout "us"
        }
        numlock
    }

    touchpad {
        tap
        click-method "clickfinger"
        // natural-scroll intentionally disabled
    }

    mouse {
        // accel-profile "flat"
        // accel-speed 0.0
    }

    focus-follows-mouse
    workspace-auto-back-and-forth
}

gestures {
    hot-corners {
        off
    }
}
